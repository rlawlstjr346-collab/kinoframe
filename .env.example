# ==============================================================================
# KINOFRAME V3 — Optional OAuth & Cloud Vault Environment Variables
# ==============================================================================
# 비로그인 상태에서도 모든 아카이브 감상, 장면 PNG 컴퓨터 저장, 로컬 보관함,
# ?board= URL 공유, .kinoframe.json 파일 백업/복원은 환경변수 없이 100% 작동합니다.
# ==============================================================================

# 1. App Origin & Session Signing (HMAC-SHA256 HttpOnly Cookie)
NEXT_PUBLIC_APP_URL=http://localhost:3000
KINOFRAME_SESSION_SECRET=replace-with-at-least-32-char-random-secret

# 2. Google OAuth 2.0 (Google Cloud Console)
# Authorized redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3. Naver Login OAuth 2.0 (Naver Developers)
# Callback URL:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/callback/naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 4. Kakao Login OAuth 2.0 (Kakao Developers)
# Redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/callback/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 5. Supabase Cloud Vault Sync (Optional)
# Table DDL:
#   create table if not exists public.user_vaults (
#     user_sub text primary key,
#     provider text not null,
#     payload jsonb not null,
#     updated_at timestamptz not null default now()
#   );
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
